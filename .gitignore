**/libsrc/
**/include/xparameters*.h
**/include/xparameters*.c

# ------------------------------------------------------------
# HLS generated output
# ------------------------------------------------------------
**/.autopilot/
**/solution*/syn/
**/solution*/sim/
**/solution*/impl/
**/solution*/.autopilot/
**/solution*/.cache/
**/solution*/.Xil/
**/solution*/syn/report/
**/solution*/sim/report/

# HLS generated files
*.autopilot*
*.jou
*.log

